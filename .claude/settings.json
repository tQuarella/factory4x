{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npm install)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright install chromium*)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(git stash*)",
      "Bash(git tag build-*)",
      "Bash(git push origin main)",
      "Bash(git push origin build-*)",
      "Bash(gh run *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)"
    ],
    "deny": [
      "Edit(/.claude/settings.json)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(rm -rf *)",
      "Bash(gh secret *)",
      "Bash(gh repo delete*)"
    ],
    "ask": [
      "Edit(/VISION.md)",
      "Edit(/.claude/agents/critic.md)",
      "Edit(/scripts/gates/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/eslint.config.js)"
    ]
  }
}
